{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamcam.invalid/protocol/control-v1.schema.json",
  "title": "StreamCam direct media control wire v1",
  "description": "Current JSON messages exchanged after pairing on the authenticated WebSocket. Objects are direct and have no version/sequence envelope. Pairing challenge/proof messages use a separate phase. RTC signaling is Wi-Fi only; media stop and audio.effects also apply to USB.",
  "oneOf": [
    { "$ref": "#/$defs/rtcOffer" },
    { "$ref": "#/$defs/rtcAnswer" },
    { "$ref": "#/$defs/rtcIce" },
    { "$ref": "#/$defs/mediaStop" },
    { "$ref": "#/$defs/videoStop" },
    { "$ref": "#/$defs/audioEffects" }
  ],
  "$defs": {
    "rtcOffer": {
      "type": "object",
      "required": ["type", "sdp"],
      "properties": {
        "type": { "const": "rtc.offer" },
        "sdp": { "type": "string", "minLength": 1, "maxLength": 131000 }
      },
      "additionalProperties": false
    },
    "rtcAnswer": {
      "type": "object",
      "required": ["type", "sdp"],
      "properties": {
        "type": { "const": "rtc.answer" },
        "sdp": { "type": "string", "minLength": 1, "maxLength": 131000 }
      },
      "additionalProperties": false
    },
    "rtcIce": {
      "type": "object",
      "required": ["type", "mid", "mline", "candidate"],
      "properties": {
        "type": { "const": "rtc.ice" },
        "mid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mline": { "type": "integer", "minimum": 0, "maximum": 31 },
        "candidate": { "type": "string", "minLength": 1, "maxLength": 8192 }
      },
      "additionalProperties": false
    },
    "mediaStop": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "media.stop" } },
      "additionalProperties": false
    },
    "videoStop": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "video.stop" } },
      "additionalProperties": false
    },
    "audioEffects": {
      "type": "object",
      "required": ["type", "echoCancellation"],
      "properties": {
        "type": { "const": "audio.effects" },
        "echoCancellation": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
