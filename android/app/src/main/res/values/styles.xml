<resources>
    <style name="Theme.StreamCam" parent="Theme.StreamCam.Base"/>
    <style name="Theme.StreamCam.Base" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#0B57D0</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#D3E3FD</item>
        <item name="colorOnPrimaryContainer">#041E49</item>
        <item name="colorSecondaryContainer">#E8F0FE</item>
        <item name="colorSurface">#F8FAFD</item>
        <item name="android:colorBackground">#F8FAFD</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#F8FAFD</item>
        <item name="android:navigationBarColor">#F8FAFD</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="StreamCam.Action" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">28dp</item>
    </style>
    <style name="StreamCam.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">28dp</item>
    </style>
    <style name="StreamCam.TextAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="StreamCam.Field" parent="@android:style/Widget.Spinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@drawable/field_background</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:popupBackground">#FFFFFF</item>
    </style>
    <style name="StreamCam.FieldLabel" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#444746</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
